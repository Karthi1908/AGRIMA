# ==============================================================================
# AGRIMA Structured Product Explainer Environment Configuration
# ==============================================================================

# Google Gemini API Key (obtained from https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# Preferred Gemini Models (Official Google AI Lineup)
# Fast multimodal OCR & ingestion: gemini-3.8-flash, gemini-3.7-flash, gemini-2.5-flash
GEMINI_FLASH_MODEL=gemini-3.8-flash

# Deep financial structuring & reasoning: gemini-3.1-pro-preview, gemini-2.5-pro, gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# Server Configuration
PORT=8000
ENVIRONMENT=development

# Google Cloud Platform (GCP) Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
